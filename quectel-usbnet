#!/usr/bin/env bash
# quectel-usbnet: read or change the USB network mode of a Quectel modem.
#
# Some Quectel modems (tested: EM160R-GL) enumerate fine in MBIM mode but never
# finish ModemManager's MBIM setup, so `mmcli -L` stays empty. Switching the
# modem to QMI mode (AT+QCFG="usbnet",0) makes ModemManager use qmi_wwan
# instead. This script does that switch, and the switch back, safely.
#
#   quectel-usbnet status
#   quectel-usbnet set qmi|mbim|ecm|rndis [--port /dev/ttyUSBn] [--dry-run]
#   quectel-usbnet sim-recover [--device /dev/cdc-wdmN]
#
# `status` only reads sysfs, ModemManager, the journal and the SIM state.
# `set` stops ModemManager, talks AT to the modem, resets it, and starts
# ModemManager again. `sim-recover` power cycles a USIM that is stuck in the
# QMI application state "illegal".
set -euo pipefail

VERSION="0.1.0"
QUECTEL_VID="2c7c"
AT_TIMEOUT=3
REENUM_GONE_TIMEOUT=20
REENUM_BACK_TIMEOUT=90
MM_WAIT_TIMEOUT=90
SIM_OFF_WAIT=${QUECTEL_SIM_OFF_WAIT:-2}
SIM_READY_TIMEOUT=${QUECTEL_SIM_READY_TIMEOUT:-15}
SIM_POLL_INTERVAL=${QUECTEL_SIM_POLL_INTERVAL:-1}

# Set by cmd_set so the EXIT trap can hand ModemManager back the way it was found.
MM_TO_RESTORE=false

usage() {
  cat >&2 <<'EOF'
usage:
  quectel-usbnet status
  quectel-usbnet set MODE [--port /dev/ttyUSBn] [--dry-run]
  quectel-usbnet sim-recover [--device /dev/cdc-wdmN]
  quectel-usbnet --version

MODE is one of: qmi (usbnet 0), ecm (1), mbim (2), rndis (3).
Only qmi and mbim have been tried on real hardware.

status   Passive. Shows the Quectel USB device, which kernel driver is bound
         (that tells you the mode), what ModemManager sees, and whether its
         journal shows the MBIM timeout pattern. Touches nothing.
set      Changes state. Stops ModemManager, reads the current mode (printed so
         you can roll back), sets the new one, resets the modem, waits for it to
         come back, and starts ModemManager again. Needs root; it re-runs itself
         with sudo.
EOF
  exit 2
}

die() {
  echo "error: $*" >&2
  exit 1
}

say() {
  echo "$*"
}

mode_to_value() {
  case ${1,,} in
    qmi | rmnet | 0) echo 0 ;;
    ecm | 1) echo 1 ;;
    mbim | 2) echo 2 ;;
    rndis | 3) echo 3 ;;
    *) return 1 ;;
  esac
}

value_to_name() {
  case $1 in
    0) echo qmi ;;
    1) echo ecm ;;
    2) echo mbim ;;
    3) echo rndis ;;
    *) echo "unknown($1)" ;;
  esac
}

expected_driver() {
  case $1 in
    0) echo qmi_wwan ;;
    1) echo cdc_ether ;;
    2) echo cdc_mbim ;;
    3) echo rndis_host ;;
    *) return 1 ;;
  esac
}

# Reads an AT response on stdin, prints the usbnet value from a
# `+QCFG: "usbnet",N` line, prints nothing if there is none.
parse_usbnet() {
  tr -d '\r' | sed -n 's/.*+QCFG: *"usbnet", *\([0-9][0-9]*\).*/\1/p' | head -n 1
}

# Prints the sysfs directory of every Quectel USB device, one per line.
quectel_devices() {
  local f dir
  for f in /sys/bus/usb/devices/*/idVendor; do
    [ -e "$f" ] || continue
    if [ "$(cat "$f")" = "$QUECTEL_VID" ]; then
      dir=$(dirname "$f")
      case $(basename "$dir") in
        *:*) continue ;;
      esac
      echo "$dir"
    fi
  done
}

# The network driver bound to any interface of a USB device, or nothing.
bound_net_driver() {
  local dev=$1 iface drv
  for iface in "$dev":*; do
    [ -e "$iface/driver" ] || continue
    drv=$(basename "$(readlink "$iface/driver")")
    case $drv in
      qmi_wwan | cdc_mbim | cdc_ether | rndis_host)
        echo "$drv"
        return 0
        ;;
    esac
  done
  return 1
}

driver_to_mode() {
  case $1 in
    qmi_wwan) echo qmi ;;
    cdc_mbim) echo mbim ;;
    cdc_ether) echo ecm ;;
    rndis_host) echo rndis ;;
    *) echo unknown ;;
  esac
}

# Sends one AT command to a port and prints the response lines. Returns 1 if the
# port cannot be opened.
at_cmd() {
  local port=$1 cmd=$2 line out="" deadline
  stty -F "$port" 115200 raw -echo 2>/dev/null || true
  exec 3<>"$port" || return 1
  printf '%s\r' "$cmd" >&3
  deadline=$((SECONDS + AT_TIMEOUT))
  while ((SECONDS < deadline)); do
    if read -r -t 1 -u 3 line; then
      line=${line%$'\r'}
      out+="$line"$'\n'
      case $line in
        OK | ERROR | "+CME ERROR"*) break ;;
      esac
    fi
  done
  exec 3>&-
  printf '%s' "$out"
}

# Prints the ttyUSB nodes of a USB device, one per line. The device directory in
# /sys/bus/usb/devices is a symlink, so find has to be told to follow it.
device_ttys() {
  find -L "$1" -maxdepth 3 -name 'ttyUSB*' 2>/dev/null | sort
}

# Prints the /dev/cdc-wdmN nodes of a USB device, one per line. Same symlink
# trap as device_ttys: without -L, find prints nothing.
device_wdm() {
  find -L "$1" -maxdepth 3 -name 'cdc-wdm*' 2>/dev/null | sort | while read -r n; do
    echo "/dev/$(basename "$n")"
  done
}

# Reads `qmicli --uim-get-card-status` on stdin and prints the application
# state of slot 1, application 1 ("ready", "illegal", ...), or nothing.
parse_app_state() {
  awk '
    /^[ \t]*Slot \[/ { slot = ($0 ~ /\[1\]/); app = 0; next }
    /^[ \t]*Application \[/ { app = (slot && $0 ~ /\[1\]/); next }
    app && /Application state:/ {
      sub(/.*Application state: *\x27/, "")
      sub(/[ \x27(].*/, "")
      print
      exit
    }'
}

# Prints the USIM application state of a cdc-wdm node, or nothing if qmicli
# cannot read it. -p goes through qmi-proxy, so the read is safe while
# ModemManager has the modem open.
sim_app_state() {
  qmicli -p -d "$1" --uim-get-card-status 2>/dev/null | parse_app_state || true
}

# The status lines for the SIM, flagging the wedged state.
sim_status_lines() {
  local wdm=$1 state
  state=$(sim_app_state "$wdm")
  if [ -z "$state" ]; then
    say "USIM state:    unknown ($wdm not readable by qmicli; try sudo)"
    return 0
  fi
  say "USIM state:    $state ($wdm)"
  if [ "$state" = illegal ]; then
    say "               WEDGED: the USIM application is stuck in 'illegal', so ModemManager"
    say "               reports sim-missing even if AT+CPIN? says READY. Try:  sudo quectel-usbnet sim-recover"
  fi
}

# Prints the first tty of a USB device that answers ATI with "Quectel". A port
# that was only just released can need a second or two, so each is tried 3 times.
find_at_port() {
  local dev=$1 tty port reply
  while read -r tty; do
    port=/dev/$(basename "$tty")
    [ -e "$port" ] || continue
    for _ in 1 2 3; do
      reply=$(at_cmd "$port" ATI 2>/dev/null || true)
      if [[ $reply == *Quectel* ]]; then
        echo "$port"
        return 0
      fi
      sleep 1
    done
  done < <(device_ttys "$dev")
  return 1
}

mm_active() {
  systemctl is-active --quiet ModemManager 2>/dev/null
}

mm_modem_listed() {
  local listing
  command -v mmcli >/dev/null 2>&1 || return 1
  listing=$(mmcli -L 2>/dev/null || true)
  [[ $listing == */Modem/* ]]
}

restore_mm() {
  if $MM_TO_RESTORE; then
    systemctl start ModemManager || true
  fi
}

# True when any Quectel device has the wanted network driver bound.
quectel_has_driver() {
  local want=$1 d
  while read -r d; do
    if [ "$(bound_net_driver "$d" 2>/dev/null || true)" = "$want" ]; then
      return 0
    fi
  done < <(quectel_devices)
  return 1
}

# Polls until the wanted driver is bound or the timeout passes.
wait_for_driver() {
  local want=$1 timeout=$2 end
  end=$((SECONDS + timeout))
  while ((SECONDS < end)); do
    if quectel_has_driver "$want"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

# Polls until a sysfs path is gone or the timeout passes.
wait_for_gone() {
  local path=$1 timeout=$2 end
  end=$((SECONDS + timeout))
  while ((SECONDS < end)); do
    if [ ! -e "$path" ]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

wait_for_modem() {
  local timeout=$1 end
  end=$((SECONDS + timeout))
  while ((SECONDS < end)); do
    if mm_modem_listed; then
      return 0
    fi
    sleep 2
  done
  return 1
}

cmd_status() {
  local devs dev drv mode timeouts journal wdm
  mapfile -t devs < <(quectel_devices)
  if [ "${#devs[@]}" -eq 0 ]; then
    say "usb:           no Quectel device (vendor $QUECTEL_VID) on the bus"
    say "               not enumerated: check the card, the slot and rfkill before anything else"
    return 1
  fi
  for dev in "${devs[@]}"; do
    say "usb:           $(basename "$dev") $(cat "$dev/idVendor"):$(cat "$dev/idProduct") $(cat "$dev/product" 2>/dev/null || true)"
    say "               speed $(cat "$dev/speed" 2>/dev/null || echo '?') Mbps, authorized $(cat "$dev/authorized" 2>/dev/null || echo '?')"
    if drv=$(bound_net_driver "$dev"); then
      mode=$(driver_to_mode "$drv")
      say "net driver:    $drv (mode: $mode)"
    else
      say "net driver:    none bound"
    fi
    if command -v qmicli >/dev/null 2>&1; then
      while read -r wdm; do
        sim_status_lines "$wdm"
      done < <(device_wdm "$dev")
    fi
  done
  if mm_active; then
    say "ModemManager:  running"
  else
    say "ModemManager:  not running"
  fi
  if command -v mmcli >/dev/null 2>&1; then
    if mm_modem_listed; then
      say "mmcli -L:      $(mmcli -L 2>/dev/null | grep '/Modem/' | sed 's/^ *//')"
    else
      say "mmcli -L:      no modems found"
    fi
  fi
  journal=$(journalctl -b -u ModemManager --no-pager 2>&1 || true)
  if [[ $journal == *"insufficient permissions"* || $journal == *"not seeing messages"* || -z $journal ]]; then
    say "MM journal:    not readable here (try sudo, or join the systemd-journal group)"
  else
    timeouts=$(printf '%s\n' "$journal" | grep -c 'marking modem as invalid' || true)
    say "MM journal:    'marking modem as invalid' seen $timeouts time(s) this boot"
    if [ "$timeouts" -gt 0 ] && ! mm_modem_listed; then
      say ""
      say "This is the pattern quectel-usbnet fixes: the device is on the bus and"
      say "ModemManager gave up on it. Try:  sudo quectel-usbnet set qmi"
    fi
  fi
}

cmd_set() {
  local target="" port="" dry=false value current_raw current want_driver dev="" devs
  while [ $# -gt 0 ]; do
    case $1 in
      --port)
        [ $# -ge 2 ] || usage
        port=$2
        shift 2
        ;;
      --dry-run)
        dry=true
        shift
        ;;
      -*) usage ;;
      *)
        [ -z "$target" ] || usage
        target=$1
        shift
        ;;
    esac
  done
  [ -n "$target" ] || usage
  value=$(mode_to_value "$target") || die "unknown mode '$target' (qmi, ecm, mbim, rndis)"
  want_driver=$(expected_driver "$value")

  if $dry; then
    say "dry run, nothing will be touched. With 'set $target' this would:"
    say "  1. stop ModemManager if it is running"
    say "  2. find the Quectel AT port${port:+ (using $port)} and read AT+QCFG=\"usbnet\""
    say "  3. send AT+QCFG=\"usbnet\",$value and confirm it reads back"
    say "  4. send AT+CFUN=1,1 (modem reset) and wait for $want_driver to bind"
    say "  5. start ModemManager and wait for a modem to be listed"
    return 0
  fi

  if [ "$(id -u)" -ne 0 ]; then
    say "set needs root (ModemManager control, tty access); re-running with sudo"
    if [ -n "$port" ]; then
      exec sudo -- "$(readlink -f "${BASH_SOURCE[0]}")" set "$target" --port "$port"
    fi
    exec sudo -- "$(readlink -f "${BASH_SOURCE[0]}")" set "$target"
  fi

  mapfile -t devs < <(quectel_devices)
  if [ -z "$port" ]; then
    [ "${#devs[@]}" -gt 0 ] || die "no Quectel USB device found; run 'quectel-usbnet status'"
    [ "${#devs[@]}" -eq 1 ] || die "more than one Quectel device; pass --port /dev/ttyUSBn for the one you mean"
    dev=${devs[0]}
  fi

  if mm_active; then
    MM_TO_RESTORE=true
    trap restore_mm EXIT
    say "stopping ModemManager"
    systemctl stop ModemManager
  fi

  if [ -z "$port" ]; then
    say "looking for the AT port"
    port=$(find_at_port "$dev") || die "no tty of $(basename "$dev") answered ATI; pass --port"
  fi
  say "AT port: $port"

  current_raw=$(at_cmd "$port" 'AT+QCFG="usbnet"') || die "cannot talk to $port"
  current=$(printf '%s' "$current_raw" | parse_usbnet)
  [ -n "$current" ] || die "could not read the usbnet mode (got: $(printf '%s' "$current_raw" | tr '\r\n' '  '))"
  say "current mode: $(value_to_name "$current") (usbnet $current)"
  say "rollback:     quectel-usbnet set $(value_to_name "$current")"
  if [ "$current" = "$value" ]; then
    say "already in $target mode, nothing to change"
    return 0
  fi

  say "setting usbnet $value ($target)"
  local reply readback
  reply=$(at_cmd "$port" "AT+QCFG=\"usbnet\",$value") || die "cannot talk to $port"
  [[ $reply == *OK* ]] || die "the modem refused AT+QCFG=\"usbnet\",$value"
  reply=$(at_cmd "$port" 'AT+QCFG="usbnet"') || die "cannot talk to $port"
  readback=$(printf '%s' "$reply" | parse_usbnet)
  [ "$readback" = "$value" ] || die "mode did not stick (reads back as '$readback')"

  say "resetting the modem (AT+CFUN=1,1)"
  at_cmd "$port" 'AT+CFUN=1,1' >/dev/null || true

  # The USB device does not drop the instant the reset is accepted; wait for
  # it to go, then for it to come back with the right driver bound.
  if [ -n "$dev" ]; then
    wait_for_gone "$dev/idVendor" "$REENUM_GONE_TIMEOUT" || say "(device did not visibly drop; continuing)"
  else
    sleep 5
  fi
  say "waiting for $want_driver to bind"
  wait_for_driver "$want_driver" "$REENUM_BACK_TIMEOUT" ||
    die "the modem did not come back with $want_driver; check 'quectel-usbnet status' (rollback: set $(value_to_name "$current"))"

  if $MM_TO_RESTORE; then
    say "starting ModemManager"
    systemctl start ModemManager
    MM_TO_RESTORE=false
    if wait_for_modem "$MM_WAIT_TIMEOUT"; then
      say "ModemManager lists the modem:"
      mmcli -L | sed 's/^ */  /'
    else
      die "ModemManager did not list a modem within ${MM_WAIT_TIMEOUT}s; check 'quectel-usbnet status'"
    fi
  fi
}

# Result line for scripts (Hammunition calls this): the only thing on stdout.
sim_result() {
  echo "sim-recover: $1"
}

sim_fail() {
  echo "error: $*" >&2
  sim_result failed
  exit 1
}

cmd_sim_recover() {
  local wdm="" devs state waited
  while [ $# -gt 0 ]; do
    case $1 in
      --device)
        [ $# -ge 2 ] || usage
        wdm=$2
        shift 2
        ;;
      *) usage ;;
    esac
  done

  if [ "$(id -u)" -ne 0 ]; then
    echo "sim-recover needs root (ModemManager control, cdc-wdm access); re-running with sudo" >&2
    if [ -n "$wdm" ]; then
      exec sudo -- "$(readlink -f "${BASH_SOURCE[0]}")" sim-recover --device "$wdm"
    fi
    exec sudo -- "$(readlink -f "${BASH_SOURCE[0]}")" sim-recover
  fi

  command -v qmicli >/dev/null 2>&1 || sim_fail "qmicli not found (package libqmi-utils)"
  if [ -z "$wdm" ]; then
    mapfile -t devs < <(
      while read -r d; do device_wdm "$d"; done < <(quectel_devices)
    )
    [ "${#devs[@]}" -gt 0 ] || sim_fail "no cdc-wdm node on a Quectel device; run 'quectel-usbnet status'"
    [ "${#devs[@]}" -eq 1 ] || sim_fail "more than one cdc-wdm node; pass --device /dev/cdc-wdmN"
    wdm=${devs[0]}
  fi

  state=$(sim_app_state "$wdm")
  [ -n "$state" ] || sim_fail "could not read the USIM state from $wdm"
  if [ "$state" = ready ]; then
    echo "USIM application is already ready; nothing to do" >&2
    sim_result ready
    return 0
  fi
  echo "USIM application state is '$state'; power cycling the SIM" >&2

  if mm_active; then
    MM_TO_RESTORE=true
    trap restore_mm EXIT
    echo "stopping ModemManager" >&2
    systemctl stop ModemManager >&2 || sim_fail "could not stop ModemManager"
  fi

  qmicli -d "$wdm" --uim-sim-power-off=1 >&2 || sim_fail "--uim-sim-power-off=1 failed on $wdm"
  sleep "$SIM_OFF_WAIT"
  qmicli -d "$wdm" --uim-sim-power-on=1 >&2 || sim_fail "--uim-sim-power-on=1 failed on $wdm"

  state=""
  waited=$((SECONDS + SIM_READY_TIMEOUT))
  while ((SECONDS < waited)); do
    state=$(sim_app_state "$wdm")
    [ "$state" != ready ] || break
    sleep "$SIM_POLL_INTERVAL"
  done
  [ "$state" = ready ] || sim_fail "USIM application did not become ready within ${SIM_READY_TIMEOUT}s (last state: ${state:-unreadable})"

  if $MM_TO_RESTORE; then
    echo "starting ModemManager" >&2
    systemctl start ModemManager >&2 || sim_fail "recovered the SIM but could not start ModemManager"
    MM_TO_RESTORE=false
  fi
  sim_result recovered
}

main() {
  [ $# -ge 1 ] || usage
  case $1 in
    status) cmd_status ;;
    set)
      shift
      cmd_set "$@"
      ;;
    sim-recover)
      shift
      cmd_sim_recover "$@"
      ;;
    --version) echo "quectel-usbnet $VERSION" ;;
    *) usage ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
